# Copy this file to `android/keystore.properties` (which is git-ignored) for local release signing,
# or provide ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, and ANDROID_KEY_PASSWORD
# as CI/CD environment variables. NEVER commit real passwords or .jks/.keystore files.
storeFile=/absolute/path/to/bus-jam-release-key.jks
storePassword=CHANGE_ME_IN_LOCAL_ENV
keyAlias=busjam-release
keyPassword=CHANGE_ME_IN_LOCAL_ENV
